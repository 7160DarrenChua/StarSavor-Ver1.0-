    - target: {fileID: 2352413010422405402, guid: f176c6494ed2d5d4190ed62dbf068738, type: 3}
      propertyPath: name1
      value: Old Man Mango
      objectReference: {fileID: 0}
    - target: {fileID: 2352413010422405402, guid: f176c6494ed2d5d4190ed62dbf068738, type: 3}
      propertyPath: toolInfoB
      value: This is a canvas specifically meant for displaying dialogue between
        two characters were both character profile images will be displayed at the
        same time on opposite ends sharing a dialogue box. Press [Space or Enter
        Key] to progress through the dialogue.
      objectReference: {fileID: 0}
    - target: {fileID: 2352413010422405402, guid: f176c6494ed2d5d4190ed62dbf068738, type: 3}
      propertyPath: entryAnimation
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 2352413010422405402, guid: f176c6494ed2d5d4190ed62dbf068738, type: 3}
      propertyPath: 'dialogueArray.Array.data[0]'
      value: 'Old Man Mango: Whats up raspberry...'
      objectReference: {fileID: 0}
    - target: {fileID: 2352413010422405402, guid: f176c6494ed2d5d4190ed62dbf068738, type: 3}
      propertyPath: 'dialogueArray.Array.data[1]'
      value: 'Raspberry: Oh thank goodness Mango, have you seen Cherry and Blueberry
        around it''s late and I''m worried they were supposed to be home by now?'
      objectReference: {fileID: 0}
    - target: {fileID: 2352413010422405402, guid: f176c6494ed2d5d4190ed62dbf068738, type: 3}
      propertyPath: 'dialogueArray.Array.data[2]'
      value: 'Old Man Mango: Raspberry, I''m sorry but it''s Cherry...something happend.
        Something bad.'
      objectReference: {fileID: 0}
    - target: {fileID: 2352413010422405402, guid: f176c6494ed2d5d4190ed62dbf068738, type: 3}
      propertyPath: 'dialogueArray.Array.data[3]'
      value: 'Raspberry: ...what.'
      objectReference: {fileID: 0}
    - target: {fileID: 4048437412346409478, guid: f176c6494ed2d5d4190ed62dbf068738, type: 3}
