  m_Name: 
  m_EditorClassIdentifier: 
  toolInfoA: 'This is a canvas specifically meant for displaying dialogue between
    two characters showing a single character talking at a time. '
  toolInfoB: 'This is a canvas specifically meant for displaying dialogue between
    two characters showing a single character talking at a time. '
  toolInfoC: This is a canvas specifically meant for displaying dialogue between
    two characters were character profile images will be displayed within the dialogue
    box, and showing a single character talking at a time.
  dialogueStyle: 2
  entryAnimation: 1
  exitAnimation: 0
  StyleGroup: {fileID: 3822799981710547723}
  animator: {fileID: 0}
  nameText: {fileID: 0}
  name1: Raspberry
  profileImage1: {fileID: 0}
  profileImage2: {fileID: 0}
  name2: Doctor Avocado
  nameTextArray:
  - {fileID: 6327630716175094266}
  - {fileID: 1171990325814381357}
  profileImageArray:
  - {fileID: 2656728720277361669}
  - {fileID: 6438876691036276217}
  dialogueArrayIndex: 0
  typingSpeed: 0.05
  dialogueText: {fileID: 418543431632350838}
  dialogueArray:
  - WHERE ARE THEY!
  - Young lady please calm down. I'm one of the doctors here at SuperMarks Hospital.
    Who are you looking for?
  - My brothers Cherry and Blueberry were admitted here because of an accident what
    happened?!
  - Oh...you must be Raspberry. I'm sorry son but Cherry was never admitted...
  - ...what...
  - There was only a stem and chunk of cherry that looked identical...to a bite mark.
  - When your brothers went racing on their skateboards they were attack by someone,
    or something. Blueberry said this before we had to put him in a medically induced
    coma.
  - He was too in shock and all over the place. He was at risk of reopening his sticthes
    that would've lead to more blood lose.
  - ...c-can...can I see him.
  - ...
  - Yes. Right this way.
  characterSwapPoints: 0000000001000000020000000300000004000000050000000800000009000000
  nextButton: {fileID: 325601995942297372}
  clickCount: 0
  source: {fileID: 2822443179065877824}
  clips: []
